# Magento REST/GraphQL — OAuth 1.0a Integration credentials.
# Create in Magento Admin: System -> Extensions -> Integrations -> Add New Integration.
# Grant it only the API resources this server actually needs, then Activate it
# to get these four values (shown once). This avoids the 2FA restriction that
# blocks admin-user token auth, and is the least-privilege approach besides.
MAGENTO_BASE_URL=https://your-magento-store.example.com
MAGENTO_CONSUMER_KEY=change_me
MAGENTO_CONSUMER_SECRET=change_me
MAGENTO_ACCESS_TOKEN=change_me
MAGENTO_ACCESS_TOKEN_SECRET=change_me

# Magento DB (read-only user only — see plan/README for grant setup)
MAGENTO_DB_HOST=127.0.0.1
MAGENTO_DB_PORT=3306
MAGENTO_DB_NAME=magento
MAGENTO_DB_READONLY_USER=mcp_readonly
MAGENTO_DB_READONLY_PASSWORD=change_me

# Safety limits (optional, defaults shown)
MAGENTO_DB_QUERY_TIMEOUT_MS=5000
MAGENTO_DB_MAX_ROWS=500
MAGENTO_DB_POOL_SIZE=3

# Optional: reach the DB through an SSH tunnel instead of connecting to
# MAGENTO_DB_HOST/PORT directly. Useful when MySQL isn't (and shouldn't be)
# reachable from this server's network directly — e.g. it's on the Magento
# box behind a bastion, or you don't want to open MySQL's port to the internet.
# When set, MAGENTO_DB_HOST/PORT above are resolved AS SEEN FROM THE SSH HOST
# (they can be "127.0.0.1" if MySQL runs on the SSH host itself, or a private
# IP/hostname the SSH host can reach). Provide either MAGENTO_DB_SSH_PASSWORD
# or MAGENTO_DB_SSH_PRIVATE_KEY_PATH (a private key file is preferred over a
# password). Leave MAGENTO_DB_SSH_HOST unset to skip the tunnel entirely.
# MAGENTO_DB_SSH_HOST=bastion.example.com
# MAGENTO_DB_SSH_PORT=22
# MAGENTO_DB_SSH_USER=deploy
# MAGENTO_DB_SSH_PRIVATE_KEY_PATH=/home/you/.ssh/id_ed25519
# MAGENTO_DB_SSH_PASSPHRASE=
# MAGENTO_DB_SSH_PASSWORD=
